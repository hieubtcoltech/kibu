{
  "name": "kids-game-playground",
  "version": "1.0.0",
  "private": true,
  "description": "Sân chơi game cho bé: Fruit Crush, Bot Arena, Neon Racer và English Quest (học thì Hiện Tại Hoàn Thành).",
  "scripts": {
    "start": "node server.js",
    "serve": "node server.js",
    "dev": "node server.js 3000",
    "check:games": "node check-games.js",
    "check:spider-climb": "node spider-climb/check-climb.js && node spider-climb/check-play.js",
    "make:home": "node make-home.js",
    "check:bounce-hoops": "node bounce-hoops/check-levels.js",
    "check:melon-drop": "node melon-drop/check-physics.js",
    "check:water-sort": "node water-sort/check-levels.js",
    "make:water-sort": "node water-sort/make-levels.js",
    "check:screw-jam": "node screw-jam/check-levels.js",
    "make:screw-jam": "node screw-jam/make-levels.js",
    "check:claw-machine": "node -e \"console.log('Mở http://localhost:PORT/claw-machine/check-grab.html — máy đo chạy trong trình duyệt vì nó dùng chính vật lý Matter của game')\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
